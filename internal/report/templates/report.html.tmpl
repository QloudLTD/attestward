 3 -5 -3 -2 -14 8 -57 -36 -47 -47 5 -4 1 -6 -7 -4 -8 1 -14 -3 -12 -10 1 -6 -4 -11 -10 -10 -7 2 -12 -3 -10 -10 1 -8 -2 -11 -7 -8 -12 8 -33 -18 -23 -29 4 -5 2 -5 -5 -1 -6 3 -16 -1 -21 -10 -8 -14 -94 68 -480 455 -259 259 -478 472 -487 472 -8 1 -22 2 -30 2 -8 0 -21 -1 -28 -2 -18 -2 -437 -418 -438 -436 -1 -8 -1 -22 -1 -30 0 -8 0 -21 1 -28 2 -20 350 -369 361 -362 6 4 7 -1 3 -11 -5 -13 -3 -16 10 -11 12 4 14 2 10 -10 -5 -13 -2 -15 11 -10 9 4 15 3 11 -2 -7 -12 104 -123 116 -116 5 4 6 -2 2 -11 -5 -13 -3 -16 10 -11 12 4 14 2 10 -10 -5 -12 -2 -15 10 -10 9 3 16 3 16 -1 -4 -23 3 -34 17 -28 8 3 12 2 9 -3 -7 -12 394 -413 406 -405 5 3 6 -3 2 -12 -5 -14 -3 -16 11 -11 10 4 15 3 11 -3 -8 -13 33 -52 47 -44 6 4 8 3 5 -3 -8 -13 70 -96 83 -88 6 4 7 -1 3 -11 -5 -14 -3 -16 11 -11 9 4 15 3 11 -3 -8 -14 185 -202 202 -196 8 3 11 2 8 -4 -3 -5 9 -8 30 -6 36 2 110 60 99 77 -3 5 3 6 12 2 14 -5 16 -3 11 11 -4 10 -3 15 3 11 12 -7 107 93 102 108 -1 5 2 6 7 2 12 -7 227 212 223 227 -1 5 2 7 7 3 14 -8 653 634 645 647 -4 7 -2 8 5 4 14 -9 103 83 94 98 -3 5 -1 6 4 3 13 -8 195 172 187 184 -3 5 3 6 12 2 14 -5 16 -3 11 11 -4 9 -3 15 2 12 10 -7 181 157 181 174 0 7 2 11 5 9 6 -7 355 340 355 353 0 6 2 9 5 6 9 -9 67 51 60 62 -4 6 1 7 11 3 13 -5 16 -3 11 10 -4 12 -2 14 10 10 13 -5 15 -2 10 11 -4 10 -3 15 3 11 13 -8 307 292 312 319 8 44 -11 71 -149 209 -257 258 -248 250 -290 253 l-38 3 -752 -752z"/></g></svg>
<h1>Software Development Security Report</h1>
</header>

{{if .MappingVersionMismatch}}<div class="note"><strong>Note:</strong> this pack's mapping versions do not match the mapping data used to render this report. Some SSDF task/CISA cluster titles below may be missing or reflect a different revision than what actually produced these results.</div>{{end}}

<h2 id="executive-summary">Executive Summary</h2>
<table>
  <tr><th>Org</th><td>{{.Pack.Scope.Org}}</td></tr>
  <tr><th>Repos in scope</th><td>{{range $i, $r := .Pack.Scope.Repos}}{{if $i}}, {{end}}{{$r}}{{end}}</td></tr>
  <tr><th>Scan window</th><td>{{fmtTime .Pack.ScanStartedAt}} &ndash; {{fmtTime .Pack.ScanEndedAt}}</td></tr>
  <tr><th>Tool version</th><td>{{.Pack.ToolVersion}}</td></tr>
  <tr><th>Mapping versions</th><td>SSDF {{.Pack.MappingVersions.SSDF}} &middot; CISA form {{.Pack.MappingVersions.CISAForm}}{{if .Pack.MappingVersions.ScannerSignatures}} &middot; scanner signatures {{.Pack.MappingVersions.ScannerSignatures}}{{end}}{{if .Pack.MappingVersions.SelfAttestation}} &middot; self-attestation {{.Pack.MappingVersions.SelfAttestation}}{{end}}</td></tr>
  {{if .Pack.Integrity}}<tr><th>Pack SHA-256</th><td><code>{{.Pack.Integrity.SHA256}}</code></td></tr>{{end}}
</table>

<h3>Cluster status</h3>
<table>
  <tr><th>Cluster</th><th>Status</th></tr>
  {{range .Clusters}}<tr><td>{{.ID}}. {{.Title}}</td><td>{{if .HasStatus}}<span class="badge badge-{{.Status}}">{{statusBadge .Status}}</span> {{statusLabel .Status}}{{else}}<em>no data</em>{{end}}</td></tr>
  {{end}}
</table>

<h3>Result counts</h3>
<table>
  <tr><th>Status</th><th>Count</th></tr>
  {{range statusCounts .StatusCounts}}<tr><td><span class="badge badge-{{.Status}}">{{statusBadge .Status}}</span> {{statusLabel .Status}}</td><td>{{.Count}}</td></tr>
  {{end}}
</table>

<h2 id="cluster-detail">Cluster Detail</h2>
{{range .Clusters}}
<h3>Cluster {{.ID}}: {{.Title}} &mdash; {{if .HasStatus}}<span class="badge badge-{{.Status}}">{{statusBadge .Status}}</span> {{statusLabel .Status}}{{else}}<em>no data</em>{{end}}</h3>
<blockquote>{{.FormText}}</blockquote>

{{range .Tasks}}
<h4>{{.ID}} &mdash; {{if .HasStatus}}<span class="badge badge-{{.Status}}">{{statusBadge .Status}}</span> {{statusLabel .Status}}{{else}}<em>no data</em>{{end}}</h4>
{{if .Text}}<p>{{.Text}}</p>{{end}}

{{range .Checks}}
<div class="check">
<h5>{{.Title}} (<code>{{.CheckID}}</code>) &mdash; <span class="badge badge-{{.Status}}">{{statusBadge .Status}}</span> {{statusLabel .Status}}</h5>
<p>{{if .Scope.Repo}}Repo: <code>{{.Scope.Repo}}</code>. {{end}}{{.Reason}}</p>

{{if .Provenance}}<p><strong>Evidence:</strong></p>
<ul class="evidence-list">{{range .Provenance}}<li><code>{{.Method}} {{.Endpoint}}</code> at {{fmtTime .Timestamp}} (HTTP {{.HTTPStatus}}, digest <code>{{.ResponseSHA256}}</code>)</li>{{end}}</ul>{{end}}

{{if .Facts}}{{$fv := facts .Facts}}
{{if $fv.Scalars}}<ul class="facts-list">{{range $fv.Scalars}}<li>{{.Key}}: {{fmtVal .Value}}</li>{{end}}</ul>{{end}}
{{if $fv.Lists}}<ul class="facts-list">{{range $fv.Lists}}<li>{{.Key}}: {{if .Items}}{{range $i, $item := .Items}}{{if $i}}, {{end}}{{fmtVal $item}}{{end}}{{else}}(none){{end}}</li>{{end}}</ul>{{end}}
{{range $fv.Tables}}<p><strong>{{.Key}}</strong></p>
<table><tr>{{range .Columns}}<th>{{.}}</th>{{end}}</tr>
{{range .Rows}}<tr>{{range .}}<td>{{fmtVal .}}</td>{{end}}</tr>
{{end}}</table>
{{end}}
{{end}}
</div>
{{end}}
{{end}}
{{end}}

<h2 id="gaps">Gaps</h2>
{{if .Gaps}}<p>Every <code>verified-fail</code> or <code>partial</code> result, in one place. See poam.md for remediation tracking.</p>
<table>
  <tr><th>POA&amp;M ID</th><th>Check</th><th>Repo</th><th>Status</th><th>Reason</th></tr>
  {{range .Gaps}}<tr><td>{{if .POAMID}}{{.POAMID}}{{else}}&mdash;{{end}}</td><td><code>{{.Result.CheckID}}</code></td><td>{{if .Result.Scope.Repo}}{{.Result.Scope.Repo}}{{else}}(org){{end}}</td><td><span class="badge badge-{{.Result.Status}}">{{statusBadge .Result.Status}}</span> {{statusLabel .Result.Status}}</td><td>{{.Result.Reason}}</td></tr>
  {{end}}
</table>{{else}}<p>No gaps found &mdash; every check that could be verified reported <code>verified-pass</code>.</p>{{end}}

<h2 id="self-attested-appendix">Self-Attested &amp; Not-Checkable Appendix</h2>
<p>Controls in this section were <strong>not independently verified</strong> by this tool &mdash; either the
producer's own claim (self-attested) or a control this tool structurally cannot verify
via API (not-checkable, e.g. plan-gated or no answer on file). Neither status ever
upgrades a CISA form cluster to fully verified.</p>

<h3>Self-Attested</h3>
{{if .SelfAttested}}{{range .SelfAttested}}<div class="check">
<h5><code>{{.Result.CheckID}}</code> &mdash; <span class="badge badge-{{.Result.Status}}">{{statusBadge .Result.Status}}</span> {{statusLabel .Result.Status}}</h5>
<p><strong>{{.Result.Title}}</strong></p>
<p>{{.Result.Reason}}</p>
{{if .Paired}}<p><strong>Complements these API-verified checks:</strong></p>
<ul>{{range .Paired}}<li><code>{{.CheckID}}</code>: <span class="badge badge-{{.Status}}">{{statusBadge .Status}}</span> {{statusLabel .Status}} &mdash; {{.Reason}}</li>{{end}}</ul>{{end}}
</div>{{end}}{{else}}<p>None.</p>{{end}}

<h3>Not Checkable</h3>
{{if .NotCheckable}}<table>
  <tr><th>Check</th><th>Repo</th><th>Reason</th></tr>
  {{range .NotCheckable}}<tr><td><code>{{.CheckID}}</code></td><td>{{if .Scope.Repo}}{{.Scope.Repo}}{{else}}(org){{end}}</td><td>{{.Reason}}</td></tr>
  {{end}}
</table>{{else}}<p>None.</p>{{end}}

<h2 id="methodology">Methodology</h2>
<p><strong>Status definitions:</strong></p>
<ul>
  <li><span class="badge badge-verified-pass">{{statusBadge "verified-pass"}}</span> <strong>Verified Pass</strong> &mdash; the tool queried the platform API and the returned state satisfies the check's pass condition. Never inferred, only observed.</li>
  <li><span class="badge badge-verified-fail">{{statusBadge "verified-fail"}}</span> <strong>Verified Fail</strong> &mdash; the tool queried the platform API and the returned state does not satisfy the check's pass condition. Just as definitive as verified-pass.</li>
  <li><span class="badge badge-partial">{{statusBadge "partial"}}</span> <strong>Partial</strong> &mdash; the tool queried the platform API and got a mixed or incomplete signal: some but not all of a check's sub-conditions hold, or the evidence is suggestive but not conclusive either way.</li>
  <li><span class="badge badge-self-attested">{{statusBadge "self-attested"}}</span> <strong>Self-Attested</strong> &mdash; no API call can verify this control; the answer comes from the producer's own self-attestation questionnaire, not platform evidence.</li>
  <li><span class="badge badge-not-checkable">{{statusBadge "not-checkable"}}</span> <strong>Not Checkable</strong> &mdash; the tool could not determine an answer at all (plan-gated, insufficient token permission, or an unanswered self-attestation question). An honest &ldquo;unknown&rdquo;, never inferred as a pass or a fail.</li>
</ul>

<p><strong>Lookback window:</strong> {{.Pack.Scope.LookbackReleases}} releases / {{.Pack.Scope.LookbackMonths}} months, release tag pattern <code>{{.Pack.Scope.ReleaseTagPattern}}</code>.</p>

<p><strong>What this tool does NOT verify:</strong> developer security training, threat-modeling practice
in depth, documented triage/remediation SLAs beyond what a self-attestation records,
agency-notification process, and any control neither an API call nor the self-attestation
questionnaire can reach. This tool is read-only: it never writes to the scanned platform,
and every claim above traces to either a specific API response (verified-*, partial,
not-checkable) or an explicit producer statement (self-attested) &mdash; never to inference,
and never faked.</p>

<footer>Generated by attestward {{.Pack.ToolVersion}}. This report is derived entirely from evidence.json; it makes no claims beyond what that file records.</footer>

</body>
</html>
