<title>Software Development Security Report — attestward-demo</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; line-height: 1.5; }
  h1, h2, h3, h4, h5 { line-height: 1.2; }
  table { border-collapse: collapse; width: 100%; margin: 0.75rem 0; }
  th, td { border: 1px solid #8887; padding: 0.35rem 0.6rem; text-align: left; vertical-align: top; }
  th { background: #8881; }
  code { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.9em; }
  blockquote { border-left: 3px solid #8887; margin: 0.5rem 0; padding: 0.25rem 0.75rem; opacity: 0.85; }
  .badge { font-weight: 600; font-family: ui-monospace, Menlo, Consolas, monospace; padding: 0.05rem 0.4rem; border: 1px solid currentColor; border-radius: 0.25rem; white-space: nowrap; }
  .badge-verified-pass { color: #1a7f37; }
  .badge-verified-fail { color: #cf222e; }
  .badge-partial { color: #9a6700; }
  .badge-self-attested { color: #6639ba; }
  .badge-not-checkable { color: #57606a; }
  .evidence-list, .facts-list { margin: 0.25rem 0; padding-left: 1.25rem; }
  .check { border: 1px solid #8884; border-radius: 0.4rem; padding: 0.75rem 1rem; margin: 0.75rem 0; }
  .note { border: 1px solid #9a6700; border-radius: 0.4rem; padding: 0.5rem 0.75rem; margin: 0.75rem 0; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #8887; opacity: 0.75; font-size: 0.9em; }
  header { display: flex; align-items: center; gap: 0.9rem; }
  header svg { flex: none; height: 3.25rem; width: auto; }
  header h1 { margin: 0; }
  @media print { .check { break-inside: avoid; } }
</style>
</head>
