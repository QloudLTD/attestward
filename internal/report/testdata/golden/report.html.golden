<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Software Development Security Report — attestward-demo</title>
<style>
  :root {
    color-scheme: light dark;

    --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", Helvetica, Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;

    --page: #f5f7f9;
    --surface: #ffffff;
    --surface-subtle: #f6f8fa;
    --surface-emphasis: #eef2f6;
    --text: #18202a;
    --text-muted: #596675;
    --text-faint: #738090;
    --border: #c9d1da;
    --border-strong: #8995a3;
    --accent: #245d8f;
    --accent-soft: #e8f1f8;
    --focus: #1478bd;
    --stripe: rgba(45, 67, 89, 0.035);
    --shadow: 0 1px 2px rgba(20, 30, 40, 0.06),
      0 6px 18px rgba(20, 30, 40, 0.035);

    --pass-bg: #e9f5ed;
    --pass-text: #1d5d35;
    --pass-border: #4f8a63;
    --fail-bg: #fbecec;
    --fail-text: #8b2424;
    --fail-border: #b44b4b;
    --partial-bg: #fff4d8;
    --partial-text: #73510b;
    --partial-border: #a77a1b;
    --self-bg: #edf0fa;
    --self-text: #394c82;
    --self-border: #6e7faa;
    --unchecked-bg: #f0f1f3;
    --unchecked-text: #4f5964;
    --unchecked-border: #7e8791;

    --radius: 5px;
    --content-width: 60rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --page: #11161c;
      --surface: #171d24;
      --surface-subtle: #1d252e;
      --surface-emphasis: #242e39;
      --text: #e7ebef;
      --text-muted: #b3bdc8;
      --text-faint: #929eaa;
      --border: #3b4652;
      --border-strong: #667381;
      --accent: #78b6e6;
      --accent-soft: #1d3446;
      --focus: #8bc8f4;
      --stripe: rgba(255, 255, 255, 0.025);
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.28),
        0 8px 22px rgba(0, 0, 0, 0.16);

      --pass-bg: #173326;
      --pass-text: #a9dfb8;
      --pass-border: #5a9870;
      --fail-bg: #3a2022;
      --fail-text: #f0b1b1;
      --fail-border: #bd6565;
      --partial-bg: #382f18;
      --partial-text: #efd28b;
      --partial-border: #ac8731;
      --self-bg: #222c46;
      --self-text: #bac8f2;
      --self-border: #7789bf;
      --unchecked-bg: #282d33;
      --unchecked-text: #c7cdd4;
      --unchecked-border: #838c96;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--page);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.58;
    text-rendering: optimizeLegibility;
    -webkit-text-size-adjust: 100%;
  }

  body {
    width: min(calc(100% - 2rem), var(--content-width));
    margin: 0 auto;
    padding: 2.5rem 0 4rem;
    background: transparent;
  }

  main,
  .report {
    display: block;
  }

  header,
  .report-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem 1.25rem;
    margin-bottom: 2.5rem;
    padding: 1.25rem 0 1.4rem;
    border-top: 4px solid var(--accent);
    border-bottom: 1px solid var(--border-strong);
  }

  .logo,
  .report-logo {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    color: var(--accent);
  }

  .logo svg,
  .report-logo svg {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    fill: currentColor;
  }

  .report-kicker {
    margin: 0 0 0.15rem;
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  h4,
  h5 {
    color: var(--text);
    font-weight: 650;
    letter-spacing: -0.018em;
    line-height: 1.25;
    text-wrap: balance;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.55rem, 4vw, 2.15rem);
    letter-spacing: -0.027em;
  }

  h2 {
    margin: 2.75rem 0 1rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--border-strong);
    font-size: 1.35rem;
  }

  h2::before {
    display: inline-block;
    width: 0.22rem;
    height: 0.92em;
    margin-right: 0.55rem;
    border-radius: 1px;
    background: var(--accent);
    content: "";
    vertical-align: -0.08em;
  }

  h3 {
    margin: 2.1rem 0 0.75rem;
    font-size: 1.16rem;
  }

  h4 {
    margin: 1.6rem 0 0.65rem;
    font-size: 1.02rem;
  }

  h5 {
    margin: 1.25rem 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  p,
  ul,
  ol,
  dl,
  pre,
  table {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  p {
    max-width: 72ch;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  a:hover {
    text-decoration-thickness: 0.13em;
  }

  :focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .section-intro,
  .section-note,
  .muted {
    color: var(--text-muted);
  }

  .section-intro {
    max-width: 72ch;
    margin: -0.35rem 0 1.15rem;
  }

  .report-section {
    scroll-margin-top: 1rem;
  }

   
  .table-wrap {
    max-width: 100%;
    margin: 0 0 1.25rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  table {
    width: 100%;
    border-spacing: 0;
    border-collapse: collapse;
    background: var(--surface);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.42;
  }

  .table-wrap > table {
    margin-bottom: 0;
  }

  caption {
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.045em;
    text-align: left;
    text-transform: uppercase;
  }

  th,
  td {
    padding: 0.62rem 0.72rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  th:last-child,
  td:last-child {
    border-right: 0;
  }

  tr:last-child > th,
  tr:last-child > td {
    border-bottom: 0;
  }

  thead th {
    background: var(--surface-emphasis);
    color: var(--text);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  tbody tr:nth-child(even) > td,
  tbody tr:nth-child(even) > th {
    background: var(--stripe);
  }

  tbody tr:hover > td,
  tbody tr:hover > th {
    background: var(--accent-soft);
  }

  tbody th[scope="row"] {
    color: var(--text);
    font-weight: 620;
  }

  td.numeric,
  th.numeric,
  .numeric {
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  td.status-cell {
    width: 1%;
    white-space: nowrap;
  }

  .key-value-table th {
    width: 12rem;
    background: var(--surface-subtle);
    color: var(--text-muted);
    font-size: 0.77rem;
    font-weight: 700;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .key-value-table td {
    overflow-wrap: anywhere;
  }

  .counts-table td:not(:first-child),
  .counts-table th:not(:first-child) {
    text-align: right;
  }

  .hash,
  code,
  samp,
  kbd {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .hash {
    overflow-wrap: anywhere;
    word-break: break-all;
  }

  code,
  samp {
    padding: 0.1em 0.3em;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--surface-subtle);
  }

  pre {
    max-width: 100%;
    padding: 0.8rem;
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-subtle);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  pre code {
    padding: 0;
    border: 0;
    background: transparent;
    font-size: inherit;
  }

   
  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.55rem;
    padding: 0.18rem 0.48rem;
    border: 1px solid var(--unchecked-border);
    border-radius: 3px;
    background: var(--unchecked-bg);
    color: var(--unchecked-text);
    font-size: 0.7rem;
    font-weight: 760;
    letter-spacing: 0.045em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .badge::before {
    margin-right: 0.34rem;
    font-size: 0.9em;
    font-weight: 900;
    line-height: 1;
  }

  .badge-verified-pass {
    border-color: var(--pass-border);
    border-style: solid;
    background: var(--pass-bg);
    color: var(--pass-text);
  }

  .badge-verified-pass::before {
    content: "✓";
  }

  .badge-verified-fail {
    border-width: 2px;
    border-color: var(--fail-border);
    border-style: solid;
    background: var(--fail-bg);
    color: var(--fail-text);
  }

  .badge-verified-fail::before {
    content: "×";
    font-size: 1.05em;
  }

  .badge-partial {
    border-color: var(--partial-border);
    border-style: dashed;
    background: var(--partial-bg);
    color: var(--partial-text);
  }

  .badge-partial::before {
    content: "◐";
  }

  .badge-self-attested {
    border-color: var(--self-border);
    border-style: double;
    border-width: 3px;
    background: var(--self-bg);
    color: var(--self-text);
  }

  .badge-self-attested::before {
    content: "✎";
  }

  .badge-not-checkable {
    border-color: var(--unchecked-border);
    border-style: dotted;
    border-width: 2px;
    background: var(--unchecked-bg);
    color: var(--unchecked-text);
  }

  .badge-not-checkable::before {
    content: "?";
  }

   
  .check-list {
    display: grid;
    gap: 0.9rem;
    margin: 1rem 0 1.5rem;
  }

  .check-card,
  .check {
    position: relative;
    margin: 0 0 0.9rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-left: 4px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .check-card[data-status="verified-pass"],
  .check-verified-pass {
    border-left-color: var(--pass-border);
  }

  .check-card[data-status="verified-fail"],
  .check-verified-fail {
    border-left-color: var(--fail-border);
  }

  .check-card[data-status="partial"],
  .check-partial {
    border-left-style: dashed;
    border-left-color: var(--partial-border);
  }

  .check-card[data-status="self-attested"],
  .check-self-attested {
    border-left-style: double;
    border-left-width: 6px;
    border-left-color: var(--self-border);
  }

  .check-card[data-status="not-checkable"],
  .check-not-checkable {
    border-left-style: dotted;
    border-left-color: var(--unchecked-border);
  }

  .check-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.65rem 1rem;
    padding: 0.85rem 0.9rem 0.75rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-subtle);
  }

  .check-title {
    min-width: 0;
  }

  .check-title h4,
  .check-title h5,
  .check-header h4,
  .check-header h5 {
    margin: 0;
    color: var(--text);
    font-size: 0.98rem;
    letter-spacing: -0.008em;
    text-transform: none;
  }

  .check-id {
    display: block;
    margin-bottom: 0.16rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    font-weight: 650;
    letter-spacing: 0.035em;
  }

  .check-body {
    padding: 0.85rem 0.9rem 0.95rem;
  }

  .check-body > :last-child {
    margin-bottom: 0;
  }

  .check-reason {
    margin: 0 0 0.9rem;
    padding: 0.65rem 0.75rem;
    border-left: 2px solid var(--accent);
    background: var(--accent-soft);
  }

  .check-reason-label,
  .evidence-heading,
  .facts-heading {
    display: block;
    margin-bottom: 0.24rem;
    color: var(--text-muted);
    font-size: 0.69rem;
    font-weight: 750;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .evidence-list {
    margin: 0.25rem 0 1rem;
    padding-left: 1.25rem;
  }

  .evidence-list li {
    margin: 0.28rem 0;
    padding-left: 0.12rem;
    overflow-wrap: anywhere;
  }

  .evidence-list li::marker {
    color: var(--accent);
  }

  .fact-table {
    margin-bottom: 0.25rem;
    border: 1px solid var(--border);
    font-size: 0.8rem;
  }

  .fact-table th,
  .fact-table td {
    padding: 0.45rem 0.55rem;
  }

  .fact-table th[scope="row"] {
    width: 11rem;
    background: var(--surface-subtle);
    color: var(--text-muted);
  }

  .empty-state,
  .no-evidence {
    margin: 0.5rem 0 0;
    color: var(--text-muted);
    font-style: italic;
  }

   
  .gaps-table tbody th[scope="row"] {
    border-left: 3px solid var(--fail-border);
  }

  .appendix {
    padding-top: 0.25rem;
  }

  .appendix .check-card,
  .appendix .check {
    box-shadow: none;
  }

   
  .status-legend {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.7rem;
    margin: 1rem 0;
  }

  .status-definition {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 0.65rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    break-inside: avoid;
    page-break-inside: avoid;
  }

  .status-definition p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.48;
  }

  footer,
  .report-footer {
    margin-top: 3rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-strong);
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  @media (max-width: 42rem) {
    body {
      width: min(calc(100% - 1.25rem), var(--content-width));
      padding-top: 1rem;
    }

    header,
    .report-header {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .logo,
    .report-logo {
      place-items: start;
    }

    .check-header {
      grid-template-columns: 1fr;
    }

    .check-header .badge {
      justify-self: start;
    }

    .key-value-table th,
    .fact-table th[scope="row"] {
      width: auto;
    }

    th,
    td {
      padding: 0.52rem 0.58rem;
    }
  }

  @media print {
    :root {
      color-scheme: light;
      --page: #ffffff;
      --surface: #ffffff;
      --surface-subtle: #f4f4f4;
      --surface-emphasis: #e9e9e9;
      --text: #000000;
      --text-muted: #303030;
      --text-faint: #4d4d4d;
      --border: #b0b0b0;
      --border-strong: #5c5c5c;
      --accent: #1d1d1d;
      --accent-soft: #f2f2f2;
      --stripe: #f7f7f7;
      --shadow: none;

      --pass-bg: #ffffff;
      --pass-text: #000000;
      --pass-border: #333333;
      --fail-bg: #eeeeee;
      --fail-text: #000000;
      --fail-border: #000000;
      --partial-bg: #ffffff;
      --partial-text: #000000;
      --partial-border: #333333;
      --self-bg: #f4f4f4;
      --self-text: #000000;
      --self-border: #333333;
      --unchecked-bg: #ffffff;
      --unchecked-text: #000000;
      --unchecked-border: #555555;
    }

    @page {
       
      size: Letter;
      margin: 15mm 14mm 17mm;
    }

    html {
      background: #ffffff;
      font-size: 10pt;
    }

    body {
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
      background: #ffffff;
    }

    header,
    .report-header {
      margin-bottom: 1.5rem;
      padding-top: 0;
    }

    h1 {
      font-size: 20pt;
    }

    h2 {
      margin-top: 1.7rem;
      font-size: 14pt;
      break-after: avoid;
      page-break-after: avoid;
    }

    h3,
    h4,
    h5,
    caption,
    thead {
      break-after: avoid;
      page-break-after: avoid;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .table-wrap {
      overflow: visible;
      border-radius: 0;
      box-shadow: none;
    }

    table {
      font-size: 8.2pt;
    }

    thead {
      display: table-header-group;
    }

    tfoot {
      display: table-footer-group;
    }

    tr,
    td,
    th {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    tbody tr:hover > td,
    tbody tr:hover > th {
      background: inherit;
    }

    .check-card,
    .check,
    .status-definition {
      overflow: visible;
      border-radius: 0;
      box-shadow: none;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .check-card,
    .check {
      margin-bottom: 0.65rem;
    }

    .check-header,
    .check-body {
      padding: 0.6rem 0.7rem;
    }

    .badge {
      color: #000000;
      box-shadow: none;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .status-legend {
      grid-template-columns: 1fr;
    }

    pre {
      white-space: pre-wrap;
      overflow: visible;
    }

    .no-print {
      display: none !important;
    }
  }

   
  .note {
    margin: 0 0 1.5rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--partial-border);
    border-radius: var(--radius);
    background: var(--partial-bg);
    color: var(--partial-text);
  }
</style>
</head>
<body>


<header class="report-header">
<div class="report-logo">
