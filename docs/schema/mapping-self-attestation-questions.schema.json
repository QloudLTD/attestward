{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sioakim/attestward/blob/main/docs/schema/mapping-self-attestation-questions.schema.json",
  "title": "attestward mappings/self-attestation-questions.yaml",
  "description": "Structure of the questionnaire for non-API-verifiable controls (issue #23). Cross-file referential integrity (every ssdf_tasks entry must resolve in ssdf-800-218.yaml) and pairing check-ID format are enforced by internal/mapping.LoadSelfAttestationQuestions, not expressible in this schema alone.",
  "type": "object",
  "required": ["version", "questions"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "question", "answer_type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^SA\\.[a-z0-9-]+$" },
        "question": { "type": "string" },
        "ssdf_tasks": { "type": "array", "items": { "type": "string" } },
        "answer_type": { "type": "string", "enum": ["yes_no", "yes_no_evidence", "text"] },
        "evidence_prompt": { "type": "string" },
        "pairing": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
